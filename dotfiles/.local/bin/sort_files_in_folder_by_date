#!/bin/sh

set -eu

usage() {
    echo "Usage: sort_files_in_folder_by_date [folder]" >&2
    echo "Moves regular files in folder into YYYY-MM-DD folders based on creation time." >&2
}

folder=${1:-.}

if [ "$#" -gt 1 ]; then
    usage
    exit 2
fi

if [ ! -d "$folder" ]; then
    echo "Error: '$folder' is not a directory." >&2
    exit 1
fi

find "$folder" -maxdepth 1 -type f -exec sh -c '
    status=0

    for file do
        timestamp=$(stat -c %W "$file") || {
            status=1
            continue
        }

        if [ "$timestamp" -le 0 ]; then
            echo "Skipping $file: no creation time available." >&2
            status=1
            continue
        fi

        date_folder=$(date -d "@$timestamp" +%F) || {
            status=1
            continue
        }

        parent=${file%/*}
        if [ "$parent" = "$file" ]; then
            parent=.
        fi

        destination=$parent/$date_folder
        mkdir -p "$destination" || {
            status=1
            continue
        }

        mv -- "$file" "$destination/" || status=1
    done

    exit "$status"
' sh {} +
