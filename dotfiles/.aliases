export_file_vars() {
    local file="$1"

    # Check if the file exists
    if [[ ! -f "$file" ]]; then
        echo "Error: File '$file' not found."
        return 1
    fi

    # Read each line and export it
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Ignore empty lines and comments
        [[ -z "$line" || "$line" =~ ^# ]] && continue

        # Extract key and value
        key=$(echo "$line" | cut -d= -f1)
        value=$(echo "$line" | cut -d= -f2-)

        # Export variable
        export "$key=$value"
    done < "$file"

    export ENVIRONNEMENT_FILE="$file"
}

d() {
    if [[ "$#" -eq 0 ]]; then
        echo "Usage: d command [args...]"
        return 2
    fi

    local log_file="${TMPDIR:-/tmp}/detached-$(date +%Y%m%d-%H%M%S).log"
    nohup "$@" > "$log_file" 2>&1 < /dev/null &
    local pid=$!
    disown "$pid" 2>/dev/null || true

    echo "Detached PID $pid; log: $log_file"
}
alias reload='source ~/.zshrc'

#Python
alias py='python3'
alias py11='python3.11'
alias py13='python3.13'
alias avenv='source .venv/bin/activate'
alias pm='python manage.py'
alias pmr='python manage.py runserver'
alias pmmm='python manage.py makemigrations'
alias pmm='python manage.py migrate'

# Environments
alias aenv='export_file_vars ./.env'
alias penv='export_file_vars ./.env.prod'
alias denv='export_file_vars ./.env.dev'
alias ppenv='export_file_vars ./.env.ppr'
alias stenv='export_file_vars ./.env.staging'
alias paenv='source ./.env.prod'
alias daenv='source ./.env.dev'
alias aaenv='source ./.env'

# Make
alias m='make'
alias mc='make clean'
alias ma='make all'
alias mb='make build'
alias mr='make run'
alias mmu='make migrate-up'
alias mmd='make migrate down'

# Shell
alias la='ls -ah'
alias ll='ls -alh'
alias zh="cat ~/.zsh_history"
alias zhg="cat ~/.zsh_history | grep"
alias pwg="pwgen -s -y"
alias please="sudo"

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gpsu='git push --set-upstream'
alias gpsuo='git push --set-upstream origin'
alias gpl='git pull'
alias gco='git checkout'
alias gb='git branch'
alias gcb='git checkout -b'
alias gac='git add . && git commit -m'
alias gbs='git sitch -c'